# Copy to .env and fill in.
DB_PASSWORD=change-me

# Model provider defaults (each browser session can override them in Model settings).
# DEFAULT_PROVIDER=claude-cli|anthropic|ollama. Unset => anthropic if ANTHROPIC_API_KEY is set,
# else claude-cli if the binary is found and the API is not in Docker, else ollama.
DEFAULT_PROVIDER=
# Claude CLI Proxy: run `npm run claude-proxy` on the host; Docker reaches it at host.docker.internal:3099.
CLAUDE_PROXY_URL=http://host.docker.internal:3099
# Optional shared secret, set identically for the proxy process and the API.
CLAUDE_PROXY_TOKEN=
# Claude CLI (direct): only when the API runs on the host (npm run dev), never inside Docker.
CLAUDE_CLI_PATH=
CLAUDE_CLI_MODEL=haiku
# Ollama (local). From Docker the host is reachable as host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:latest
# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Local (non-Docker) development only. DB_PORT is the host port `npm run dev:db` exposes.
DB_PORT=5432
DATABASE_URL=postgres://app:change-me@localhost:5432/artlyrics
UPLOAD_DIR=./data/uploads
PORT=3000
# Retention: delete artworks older than N days (0 disables)
RETENTION_DAYS=30

# Host port for the web UI
WEB_PORT=8080

# Suno (song generation from the lyrics) via https://sunoapi.org
SUNO_API_KEY=
SUNO_MODEL=V4_5
# Public URL of this deployment, used for Suno's completion callback (e.g. https://your-app.vercel.app)
PUBLIC_BASE_URL=

# Token for the Sessions admin page (/sessions). Leave empty to disable it.
ADMIN_TOKEN=
